#include "nds_aicpu_hns_abi.h"
#include "nds_aicpu_roce_abi.h"

#include <dlfcn.h>
#include <stdint.h>

namespace {
constexpr uint32_t kSuccess = 0U;
constexpr uint32_t kInvalidArgument = 1U;
constexpr uint32_t kPostFailed = 2U;
constexpr uint32_t kProviderUnavailable = 3U;
constexpr char kHnsProviderLibrary[] = "libhns-rdmav25.so";
constexpr char kHnsPostSymbol[] = "ibv_exp_post_send";

bool valid_opcode(uint32_t opcode)
{
    return opcode == NDS_AICPU_RDMA_WRITE || opcode == NDS_AICPU_RDMA_READ || opcode == NDS_AICPU_SEND;
}

bool valid_request(const nds_aicpu_rdma_post_request_v2 &request)
{
    if (request.abi_version != NDS_AICPU_ROCE_ABI_VERSION || request.size != sizeof(request) ||
        !valid_opcode(request.opcode) || request.ai_qp_address == 0U ||
        request.local_lkey == 0U || request.local_address == 0U || request.length == 0U ||
        request.length > NDS_AICPU_ROCE_MAX_BYTES) {
        return false;
    }
    if (request.opcode == NDS_AICPU_SEND) {
        return request.remote_address == 0U && request.remote_rkey == 0U;
    }
    return request.remote_address != 0U && request.remote_rkey != 0U;
}

/* HCOMM's device DlHnsFunction ultimately uses dlopen/dlsym in its AICPU image. */
nds_hns_exp_post_send_fn hns_exp_post_send()
{
    static nds_hns_exp_post_send_fn post = nullptr;
    static void *provider = nullptr;
    if (post != nullptr) return post;
    provider = dlopen(kHnsProviderLibrary, RTLD_NOW);
    if (provider == nullptr) return nullptr;
    post = reinterpret_cast<nds_hns_exp_post_send_fn>(dlsym(provider, kHnsPostSymbol));
    return post;
}

} // namespace

extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuNoop(void *args)
{
    (void)args;
    return kSuccess;
}

/* Isolates the device-side provider loader from WQE construction and posting. */
extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuProviderProbe(void *args)
{
    (void)args;
    return hns_exp_post_send() == nullptr ? kProviderUnavailable : kSuccess;
}

/* Confirms ACL's argument buffer is readable before attempting a provider post. */
extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuRequestProbe(void *args)
{
    if (args == nullptr) return kInvalidArgument;
    const auto &request = *static_cast<const nds_aicpu_rdma_post_request_v2 *>(args);
    return valid_request(request) ? kSuccess : kInvalidArgument;
}

/*
 * Executes the provider call but deliberately suppresses its return value.
 * This separates a provider-returned post error from an exception within the
 * provider without attempting to write AICPU status into ordinary device memory.
 */
extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuPostAttemptProbe(void *args)
{
    if (args == nullptr) return kInvalidArgument;
    const auto &request = *static_cast<const nds_aicpu_rdma_post_request_v2 *>(args);
    if (!valid_request(request)) return kInvalidArgument;

    const nds_hns_exp_post_send_fn post_send = hns_exp_post_send();
    if (post_send == nullptr) return kProviderUnavailable;

    nds_hns_sge sge{};
    sge.addr = request.local_address;
    sge.length = static_cast<uint32_t>(request.length);
    sge.lkey = request.local_lkey;

    nds_hns_send_wr work_request{};
    work_request.wr_id = request.wr_id;
    work_request.sg_list = &sge;
    work_request.num_sge = 1;
    work_request.opcode = static_cast<int32_t>(request.opcode);
    work_request.send_flags = NDS_HNS_SEND_SIGNALED;
    if (request.opcode != NDS_AICPU_SEND) {
        work_request.rdma.remote_addr = request.remote_address;
        work_request.rdma.rkey = request.remote_rkey;
    }

    nds_hns_send_wr *bad_request = nullptr;
    nds_hns_post_send_response response{};
    (void)post_send(reinterpret_cast<void *>(request.ai_qp_address), &work_request, &bad_request, &response);

#if defined(__aarch64__)
    asm volatile("dsb st" ::: "memory");
#else
    asm volatile("" ::: "memory");
#endif
    return kSuccess;
}

extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuRdmaPost(void *args)
{
    if (args == nullptr) return kInvalidArgument;
    const auto &request = *static_cast<const nds_aicpu_rdma_post_request_v2 *>(args);
    if (!valid_request(request)) {
        return kInvalidArgument;
    }

    const nds_hns_exp_post_send_fn post_send = hns_exp_post_send();
    if (post_send == nullptr) {
        return kProviderUnavailable;
    }
    nds_hns_sge sge{};
    sge.addr = request.local_address;
    sge.length = static_cast<uint32_t>(request.length);
    sge.lkey = request.local_lkey;

    nds_hns_send_wr work_request{};
    work_request.wr_id = request.wr_id;
    work_request.sg_list = &sge;
    work_request.num_sge = 1;
    work_request.opcode = static_cast<int32_t>(request.opcode);
    work_request.send_flags = NDS_HNS_SEND_SIGNALED;
    if (request.opcode != NDS_AICPU_SEND) {
        work_request.rdma.remote_addr = request.remote_address;
        work_request.rdma.rkey = request.remote_rkey;
    }

    nds_hns_send_wr *bad_request = nullptr;
    nds_hns_post_send_response response{};
    const int post_result = post_send(reinterpret_cast<void *>(request.ai_qp_address), &work_request, &bad_request, &response);
    if (post_result != 0) {
        return kPostFailed;
    }

#if defined(__aarch64__)
    asm volatile("dsb st" ::: "memory");
#else
    asm volatile("" ::: "memory");
#endif
    return kSuccess;
}
