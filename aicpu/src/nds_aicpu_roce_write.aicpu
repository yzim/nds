#include "nds_aicpu_hns_abi.h"
#include "nds_aicpu_roce_abi.h"

#include <dlfcn.h>
#include <stddef.h>
#include <stdint.h>

namespace {
constexpr uint32_t kSuccess = 0U;
constexpr uint32_t kInvalidArgument = 1U;
constexpr uint32_t kPostFailed = 2U;
constexpr uint32_t kProviderUnavailable = 3U;
constexpr char kHnsProviderLibrary[] = "libhns-rdmav25.so";
constexpr char kHnsPostSymbol[] = "ibv_exp_post_send";

bool valid_request(const nds_aicpu_roce_write_request_v1 &request)
{
    return request.abi_version == NDS_AICPU_ROCE_ABI_VERSION &&
           request.size == sizeof(request) && request.ai_qp_address != 0U &&
           request.local_lkey != 0U && request.remote_rkey != 0U &&
           request.local_address != 0U && request.remote_address != 0U &&
           request.length != 0U && request.length <= NDS_AICPU_ROCE_MAX_BYTES;
}

/*
 * CANN 9.0.0 does not expose a public AICPU RNIC-post API.  The installed
 * HNS provider supplies this extension dynamically.  Resolve it here, at the
 * version-pinned provider boundary, rather than importing HCOMM or relying on
 * its process-global loader state.  The provider must stay loaded while its
 * function pointer can be used, so its handle is intentionally retained.
 */
nds_hns_exp_post_send_fn hns_exp_post_send()
{
    static nds_hns_exp_post_send_fn post = nullptr;
    static void *provider = nullptr;
    if (post != nullptr) return post;

    provider = dlopen(kHnsProviderLibrary, RTLD_NOW | RTLD_LOCAL);
    if (provider == nullptr) return nullptr;
    post = reinterpret_cast<nds_hns_exp_post_send_fn>(dlsym(provider, kHnsPostSymbol));
    return post;
}
} // namespace

extern "C" __attribute__((visibility("default"))) uint32_t NdsAicpuRoceWrite(void *args)
{
    if (args == nullptr) return kInvalidArgument;

    const auto &request = *static_cast<const nds_aicpu_roce_write_request_v1 *>(args);
    if (!valid_request(request)) return kInvalidArgument;

    const nds_hns_exp_post_send_fn post_send = hns_exp_post_send();
    if (post_send == nullptr) return kProviderUnavailable;

    nds_hns_sge sge{};
    sge.addr = request.local_address;
    sge.length = static_cast<uint32_t>(request.length);
    sge.lkey = request.local_lkey;

    nds_hns_send_wr work_request{};
    work_request.wr_id = request.wr_id;
    work_request.sg_list = &sge;
    work_request.num_sge = 1;
    work_request.opcode = NDS_HNS_WR_RDMA_WRITE;
    work_request.send_flags = NDS_HNS_SEND_SIGNALED;
    work_request.rdma.remote_addr = request.remote_address;
    work_request.rdma.rkey = request.remote_rkey;

    nds_hns_send_wr *bad_request = nullptr;
    nds_hns_post_send_response response{};
    const int result = post_send(reinterpret_cast<void *>(request.ai_qp_address),
                                 &work_request, &bad_request, &response);
    if (result != 0) return kPostFailed;

    /* Match the provider-required ordering after WQE construction/posting. */
    asm volatile("dsb st" ::: "memory");
    return kSuccess;
}
